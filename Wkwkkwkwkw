local PerfBackup = { Fog = {}, Textures = {}, Materials = {}, Shadows = {}, Particles = {}, Lights = {} }

local function setShadow(enabled)
    if enabled then
        Lighting.GlobalShadows = false; Lighting.ShadowSoftness = 0
        local count = 0
        for _, obj in ipairs(Workspace:GetDescendants()) do
            count = count + 1; if count % 200 == 0 then task.wait() end
            if obj:IsA("BasePart") then
                if PerfBackup.Shadows[obj] == nil then PerfBackup.Shadows[obj] = obj.CastShadow end
                pcall(function() obj.CastShadow = false end)
            end
        end
    else
        Lighting.GlobalShadows = true; Lighting.ShadowSoftness = 0.2
        for obj, orig in pairs(PerfBackup.Shadows) do if obj and obj.Parent then pcall(function() obj.CastShadow = orig end) end end
        table.clear(PerfBackup.Shadows)
    end
end

local function setFog(enabled)
    if enabled then
        PerfBackup.Fog.End = Lighting.FogEnd; PerfBackup.Fog.Start = Lighting.FogStart; PerfBackup.Fog.Color = Lighting.FogColor
        Lighting.FogEnd = 9e9; Lighting.FogStart = 0
        for _, v in ipairs(Lighting:GetDescendants()) do if v:IsA("Atmosphere") then pcall(function() v.Enabled = false; v.Parent = nil end) end end
    else
        if PerfBackup.Fog.End then Lighting.FogEnd = PerfBackup.Fog.End; Lighting.FogStart = PerfBackup.Fog.Start; Lighting.FogColor = PerfBackup.Fog.Color end
    end
end

local function setParticles(enabled)
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        count = count + 1; if count % 200 == 0 then task.wait() end
        if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam") then
            if enabled then
                if PerfBackup.Particles[obj] == nil then PerfBackup.Particles[obj] = obj.Enabled end
                pcall(function() obj.Enabled = false end)
            else
                if PerfBackup.Particles[obj] ~= nil then pcall(function() obj.Enabled = PerfBackup.Particles[obj] end) end
            end
        end
    end
    if not enabled then table.clear(PerfBackup.Particles) end
end

local function setTextures(enabled)
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        count = count + 1; if count % 200 == 0 then task.wait() end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if enabled then
                if PerfBackup.Textures[obj] == nil then PerfBackup.Textures[obj] = obj.Transparency end
                obj.Transparency = 1
            else
                if PerfBackup.Textures[obj] ~= nil then obj.Transparency = PerfBackup.Textures[obj] end
            end
        end
    end
    if not enabled then table.clear(PerfBackup.Textures) end
end

local function setLights(enabled)
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        count = count + 1; if count % 200 == 0 then task.wait() end
        if obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            if enabled then
                if PerfBackup.Lights[obj] == nil then PerfBackup.Lights[obj] = obj.Enabled end
                pcall(function() obj.Enabled = false end)
            else
                if PerfBackup.Lights[obj] ~= nil then pcall(function() obj.Enabled = PerfBackup.Lights[obj] end) end
            end
        end
    end
    if not enabled then table.clear(PerfBackup.Lights) end
end

local function setSmoothPlastic(enabled)
    local count = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
