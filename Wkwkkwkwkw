                    cache.HBg.From = Vector2.new(bx, hPos.Y); cache.HBg.To = Vector2.new(bx, fPos.Y); cache.HBg.Visible = true
                    cache.HBar.From = Vector2.new(bx, fPos.Y - (height * pct)); cache.HBar.To = Vector2.new(bx, fPos.Y); cache.HBar.Visible = true
                    cache.HBar.Color = Color3.fromRGB(255 * (1-pct), 255 * pct, 0)
                else cache.HBg.Visible = false; cache.HBar.Visible = false end
                if Settings.ESP_Name then cache.Name.Text = plr.Name; cache.Name.Position = Vector2.new(hPos.X, hPos.Y - 20); cache.Name.Visible = true; cache.Name.Color = Color3.new(1,1,1)
                else cache.Name.Visible = false end
                if Settings.ESP_Distance then cache.Dist.Text = math.floor(dist) .. "m"; cache.Dist.Position = Vector2.new(hPos.X, fPos.Y + 10); cache.Dist.Visible = true; cache.Dist.Color = espColor
                else cache.Dist.Visible = false end
                if Settings.ESP_Tracker then cache.Track.From = center; cache.Track.To = Vector2.new(hPos.X, hPos.Y); cache.Track.Visible = true; cache.Track.Color = espColor
                else cache.Track.Visible = false end
                if Settings.ESP_RedDot then cache.Dot.Position = Vector2.new(hPos.X, hPos.Y); cache.Dot.Visible = true; cache.Dot.Color = Color3.fromRGB(255, 0, 0)
                else cache.Dot.Visible = false end
            else hideAll(cache) end
            if Settings.ESP_Highlight then
                local hl = char:FindFirstChild("DARKHUB_HL")
                if not hl then hl = Instance.new("Highlight"); hl.Name = "DARKHUB_HL"; hl.Parent = char; hl.FillTransparency = 0.5; hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end
                hl.FillColor = espColor; hl.OutlineColor = espColor
            else
                local hl = char:FindFirstChild("DARKHUB_HL")
                if hl then hl:Destroy() end
            end
        end
    end
end)

