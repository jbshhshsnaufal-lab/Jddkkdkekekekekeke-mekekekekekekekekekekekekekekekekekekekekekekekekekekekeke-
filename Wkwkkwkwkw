-- AIMBOT
-- =====================================================================
local aimHoldStart, lastAimActive = 0, false
local function pickTarget()
    local cam = Workspace.CurrentCamera; if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    local best, bestD = nil, Settings.FOV
    local origin = cam.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and alive(p.Character) then
            local isTeammate = false
            if Settings.TeamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then isTeammate = true end
            if not isTeammate then
                local part = p.Character:FindFirstChild(Settings.AimbotBone) or p.Character:FindFirstChild("Head")
                if part then
                    local v, on = cam:WorldToViewportPoint(part.Position)
                    if on and v.Z > 0 then
                        local d = (Vector2.new(v.X, v.Y) - center).Magnitude
                        if d < bestD and visibleFrom(origin, part.Position, p.Character) then
                            bestD = d; best = part
                        end
                    end
                end
            end
        end
    end
    return best
end

RunService:BindToRenderStep("DARKHUB_Aim", Enum.RenderPriority.Camera.Value + 1, function()
    if not Settings.Aimbot then lastAimActive = false; return end
    if Settings.AimbotRMB and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        lastAimActive = false; return
    end
    if not lastAimActive then aimHoldStart = os.clock(); lastAimActive = true end
    local part = pickTarget(); if not part then return end
    local cam = Workspace.CurrentCamera; if not cam then return end
    local ramp = math.clamp((os.clock() - aimHoldStart) / 0.12, 0, 1)
    local target = CFrame.new(cam.CFrame.Position, part.Position)
    local step = 1 / math.max(Settings.AimbotSmooth, 1)
    cam.CFrame = cam.CFrame:Lerp(target, math.clamp(step * ramp, 0.02, 1))
end)

