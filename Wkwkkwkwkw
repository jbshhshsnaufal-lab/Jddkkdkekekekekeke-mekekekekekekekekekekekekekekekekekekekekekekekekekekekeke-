local function humOf(char) return char and char:FindFirstChildOfClass("Humanoid") end
local function alive(char) local h = humOf(char); return h and h.Health > 0 end

local function visibleFrom(origin, pos, char)
    if not Settings.AimbotVis then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local f = {}
    if LocalPlayer.Character then table.insert(f, LocalPlayer.Character) end
    if char then table.insert(f, char) end
    rp.FilterDescendantsInstances = f; rp.IgnoreWater = true
    return Workspace:Raycast(origin, pos - origin, rp) == nil
end

